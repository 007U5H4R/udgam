# Never commit real values; secrets go in cloud environment secrets or .env (git-ignored).
# Names only, except the three non-secret defaults below. Unset names fall back to the defaults in src/lib/config/env.ts.
# Deployment assumption (TKT-05, TKT-27): the app port is never published; the reverse proxy (Caddy, trusted_proxies unset)
# overwrites X-Forwarded-For with the client address, which the per-IP enrolment limit trusts (last hop only).
DATABASE_URL=
DATA_DIR=
LEDGER_KEY_PATH=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
PUBLIC_BASE_URL=
REMOTE_SENSING_PROVIDER=fixture
GFW_API_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
MAP_TILE_PROVIDER=esri
ARCGIS_API_KEY=
MAPTILER_KEY=
LEDGER_ADAPTER=hashchain
ANVIL_RPC_URL=
EVM_OPERATOR_KEY_PATH=
LOG_LEVEL=
DEMO_MODE=
