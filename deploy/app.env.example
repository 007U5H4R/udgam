# Never commit real values. This is the template for /etc/udgam/app.env on the instance (0600 root),
# which the owner fills in on the instance itself. Names only: no value is ever written here, pasted
# into a session or echoed. Mirrors .env.example, plus UDGAM_DOMAIN and the SEC-003 budget variables.
# An empty value means "unset": src/lib/config/env.ts then applies its default (and refuses to start
# production without the required ones). Every variable env.ts reads is listed below or named on a
# "NOT SET IN PRODUCTION" line (src/lib/config/app-env-example.test.ts checks this).

# --- Domain (TKT-27/28). Caddy serves https://$UDGAM_DOMAIN; the uptime probe uses the same name. ---
UDGAM_DOMAIN=

# --- Storage. Leave empty in the container: DATA_DIR defaults to the volume mount, the database and the
# ledger key derive from it (DATA_DIR/udgam.db, DATA_DIR/keys/ledger.jwk). ---
DATABASE_URL=
DATA_DIR=
LEDGER_KEY_PATH=

# --- Auth. BETTER_AUTH_SECRET: generate on the instance (openssl rand -base64 32), never elsewhere.
# BETTER_AUTH_URL and PUBLIC_BASE_URL: https://<UDGAM_DOMAIN>; production refuses anything but an
# absolute https:// URL (DES-219). ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
PUBLIC_BASE_URL=

# --- Remote sensing. Production requires REMOTE_SENSING_PROVIDER=live and its three keys (EXE12). ---
REMOTE_SENSING_PROVIDER=
GFW_API_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Map tiles (esri by default; a key only if TP19's provider needs one). ---
MAP_TILE_PROVIDER=
ARCGIS_API_KEY=
MAPTILER_KEY=

# --- Ledger (hashchain by default; the EVM adapter is M-002 and stays off in production). ---
LEDGER_ADAPTER=
ANVIL_RPC_URL=
EVM_OPERATOR_KEY_PATH=
# Seconds between background checkpoints of unsealed ledger entries (EXE54). Empty = 3600 (1 h).
LEDGER_CHECKPOINT_INTERVAL_SEC=

# --- Logs and demo. LOG_LEVEL empty = info. DEMO_MODE stays empty: /admin/demo never runs in production
# (EXE12, EXE33). ---
LOG_LEVEL=
DEMO_MODE=

# --- Capture storage budget per agent per India day (SEC-003). Empty = the defaults: 100 captures and
# 1258291200 bytes (100 x 3 photos x 4 MiB, EV9's placeholder). Raise only with a reason in the ledger. ---
CAPTURE_DAILY_MAX_CAPTURES=
CAPTURE_DAILY_MAX_BYTES=

# --- Disk alert (SEC-003): /api/health reports disk:"low" below this many free bytes on DATA_DIR.
# Empty = 10737418240 (10 GiB). The uptime probe alerts on anything but disk:"ok". ---
HEALTH_MIN_FREE_DISK_BYTES=

# NOT SET IN PRODUCTION: NODE_ENV (the image sets it to production).
# NOT SET IN PRODUCTION: E2E, E2E_FIXTURE_DELAY_MS (Playwright only; E2E=1 opens the test-only routes).
# NOT SET IN PRODUCTION: SEED_PASSWORD (the demo seed refuses production; use pnpm accounts:create, SEC-001).
