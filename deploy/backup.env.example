# /etc/udgam/backup.env (0600 root): settings for deploy/cron/backup.sh and restore.sh (TKT-27, TSK-27.5).
# Names only here; deploy/bootstrap.sh copies this file to the instance and the owner fills it in there.
# None of these is a secret: the age PUBLIC key encrypts, and the private key never comes to the instance.
#
# The owner's age public key (age1...). Several keys: AGE_RECIPIENTS_FILE, one per line.
AGE_RECIPIENT=
AGE_RECIPIENTS_FILE=
# The OCI Object Storage bucket the instance principal may write to (dynamic group + policy).
OCI_BUCKET=
# Optional: the tenancy's Object Storage namespace (the CLI looks it up when empty).
OCI_NAMESPACE=
# Object name prefix in the bucket.
OCI_PREFIX=backups/
# Days to keep backups, locally and in the bucket.
RETENTION_DAYS=14
# 1 = also archive DATA_DIR/media (the capture photos). Off by default: see docs/ops/deploy.md.
BACKUP_MEDIA=0
