#!/usr/bin/env bash
# Test stub for the OCI CLI's object commands. The bucket is $STUB_STATE/bucket/ (one file per object,
# '/' in names stored as '%'). `list` answers what deploy/cron/backup.sh's --query asks for: the names,
# space-separated. Knobs: STUB_OCI_LIST_FAIL=1, STUB_OCI_DELETE_FAIL=<object name>, STUB_OCI_PUT_FAIL=1.
set -euo pipefail
S="${STUB_STATE:?STUB_STATE not set}"
mkdir -p "$S/bucket"
echo "oci $*" >>"$S/calls.log"
[ "$1 $2" = "os object" ] || { echo "stub oci: unsupported: $*" >&2; exit 2; }
verb="$3"
shift 3
name="" file="" prefix=""
while [ $# -gt 0 ]; do
  case "$1" in
    --name | --object-name) name="$2"; shift 2 ;;
    --file) file="$2"; shift 2 ;;
    --prefix) prefix="$2"; shift 2 ;;
    *) shift ;;
  esac
done
key() { printf '%s' "$1" | tr '/' '%'; }
case "$verb" in
  put)
    [ "${STUB_OCI_PUT_FAIL:-0}" = 1 ] && { echo "stub oci: put failed" >&2; exit 1; }
    cp "$file" "$S/bucket/$(key "$name")"
    ;;
  get) cp "$S/bucket/$(key "$name")" "$file" ;;
  list)
    [ "${STUB_OCI_LIST_FAIL:-0}" = 1 ] && { echo "stub oci: list failed (ServiceError 401)" >&2; exit 1; }
    names=()
    for f in "$S"/bucket/*; do
      [ -e "$f" ] || continue
      n="$(basename "$f" | tr '%' '/')"
      [ "${n#"$prefix"}" != "$n" ] && names+=("$n")
    done
    echo "${names[*]}"
    ;;
  delete)
    [ "${STUB_OCI_DELETE_FAIL:-}" = "$name" ] && { echo "stub oci: delete failed" >&2; exit 1; }
    rm "$S/bucket/$(key "$name")"
    ;;
  *) echo "stub oci: unsupported verb $verb" >&2; exit 2 ;;
esac
