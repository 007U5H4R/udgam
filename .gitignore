# dependencies and build output
node_modules/
.next/
out/
dist/
coverage/
playwright-report/
test-results/

# secrets — never commit (ledger signing key, provider keys, auth secret)
.env
.env.*
!.env.example
# CI-only fake values for the bundle-secrets job (TKT-19); never real secrets
!.env.ci.example
.secrets/
*.pem
*.key
# JWK key files (ledger key, users' server-bound keys) and any key directory, wherever they land
