*.jwk
keys/

# local data — libSQL database files and uploaded media
*.db
*.db-*
*.sqlite
data/
# DATA_DIR of the CI bundle-secrets recipe (.env.ci.example), when run locally
data-ci/
/media/
# (anchored: src/lib/media/ is source code; uploads live under DATA_DIR/media)

# foundry
cache/
broadcast/

# os / editor
.DS_Store
*.log

# agent worktrees (local, never committed)
.claude/worktrees/

