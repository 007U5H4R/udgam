# CI-ONLY FAKE VALUES (TSK-19.7, TC-075, EVAL-083). Not secrets and never used anywhere real.
# The bundle-secrets job builds with this file loaded, then scripts/ci/check-bundle-secrets.sh greps the
# client bundle for each value below: any hit means a server secret reached the browser. Every secret
# name in .env.example has a distinct, clearly fake, low-entropy value here.
NODE_ENV=production
DATA_DIR=./data-ci
REMOTE_SENSING_PROVIDER=fixture
MAP_TILE_PROVIDER=esri
LEDGER_ADAPTER=hashchain
PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=ci-fake-better-auth-secret-0000000000000000
GFW_API_KEY=ci-fake-gfw-api-key-00000000
CDSE_CLIENT_ID=ci-fake-cdse-client-id-00000000
CDSE_CLIENT_SECRET=ci-fake-cdse-client-secret-00000000
ARCGIS_API_KEY=ci-fake-arcgis-api-key-00000000
MAPTILER_KEY=ci-fake-maptiler-key-00000000
