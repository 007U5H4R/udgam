{
  "name": "udgam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "eval": "tsx evals/harness/run.ts",
    "eval:validate": "tsx evals/harness/dataset.ts --validate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@tmcw/togeojson": "7.1.2",
    "@turf/turf": "7.4.0",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "better-auth": "1.7.6",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.3",
    "exifr": "7.1.3",
    "idb": "8.0.3",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "next": "16.3.6",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/leaflet-draw": "1.0.13",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
